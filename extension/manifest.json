{
  "manifest_version": 3,
  "name": "Prospection Auto LinkedIn",
  "version": "0.2.0",
  "description": "Trouve les décideurs de l'automobile sur LinkedIn, prépare tes messages et suis tes prospects. L'envoi reste manuel.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Ouvrir le panneau de prospection",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "Prospection Auto",
    "default_icon": "icons/icon-32.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage", "scripting", "clipboardWrite"],
  "host_permissions": ["https://www.linkedin.com/*"]
}
